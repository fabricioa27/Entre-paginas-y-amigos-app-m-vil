
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sunset Paradise</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container">
    <a class="navbar-brand" href="@Url.Action("Index", "Home")">Sunset Paradise</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Rooms")">Habitaciones</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Action("Available", "Rooms")">Disponibles</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Clients")">Clientes</a></li>
        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Reservations")">Reservas</a></li>
      </ul>
      <div class="d-flex">
        <a class="btn btn-outline-secondary me-2" href="@Url.Action("Logout", "Auth")">Salir</a>
      </div>
    </div>
  </div>
</nav>

<main class="container mt-3">
    @if (TempData["ok"] != null) {
        <div class="alert alert-success">@TempData["ok"]</div>
    }
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
