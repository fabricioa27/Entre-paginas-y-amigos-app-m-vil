
@model SunsetParadise.Models.Reservation
@{
    var clients = ViewBag.Clients as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var rooms = ViewBag.Rooms as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}
<h3>Nueva reserva</h3>
<form asp-action="Create" method="post" class="card card-body">
  <div class="row g-3">
    <div class="col-md-6">
      <label asp-for="ClientDUI" class="form-label"></label>
      <select asp-for="ClientDUI" class="form-select" asp-items="clients"></select>
      <span asp-validation-for="ClientDUI" class="text-danger"></span>
    </div>
    <div class="col-md-6">
      <label asp-for="RoomNumber" class="form-label"></label>
      <select asp-for="RoomNumber" class="form-select" asp-items="rooms"></select>
      <span asp-validation-for="RoomNumber" class="text-danger"></span>
    </div>
    <div class="col-md-3">
      <label asp-for="CheckIn" class="form-label"></label>
      <input asp-for="CheckIn" class="form-control" type="date" />
      <span asp-validation-for="CheckIn" class="text-danger"></span>
    </div>
    <div class="col-md-3">
      <label asp-for="CheckOut" class="form-label"></label>
      <input asp-for="CheckOut" class="form-control" type="date" />
      <span asp-validation-for="CheckOut" class="text-danger"></span>
    </div>
  </div>
  <div class="mt-3">
    <button class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" href="@Url.Action("Index", "Reservations")">Cancelar</a>
  </div>
</form>
@await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")
