
@model SunsetParadise.Models.Client
<h3>Nuevo cliente</h3>
<form asp-action="Create" method="post" class="card card-body">
  <div class="row g-3">
    <div class="col-md-6">
      <label asp-for="Name" class="form-label"></label>
      <input asp-for="Name" class="form-control" />
      <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-3">
      <label asp-for="DUI" class="form-label"></label>
      <input asp-for="DUI" class="form-control" placeholder="00000000-0" />
      <span asp-validation-for="DUI" class="text-danger"></span>
    </div>
    <div class="col-md-3">
      <label asp-for="Phone" class="form-label"></label>
      <input asp-for="Phone" class="form-control" />
      <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
  </div>
  <div class="mt-3">
    <button class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" href="@Url.Action("Index", "Clients")">Cancelar</a>
  </div>
</form>
@await Html.PartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml")
